{
  "name": "crema",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start \"vite dev\"",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && vite build",
    "start": "bun .output/server/index.mjs",
    "seed": "convex run seed:catalog",
    "format": "prettier --write .",
    "lint": "bun run typecheck && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "bun test convex"
  },
  "dependencies": {
    "@convex-dev/auth": "^2.1.0",
    "@convex-dev/react-query": "^0.1.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "convex": "^1.51.0",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/eslint-config": "^0.5.0",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "convex-test": "^0.0.75",
    "nitro": "^3.0.261103-rc",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.7",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
